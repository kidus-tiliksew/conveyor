# Copy this file to .env. Conveyor binaries load it without replacing variables
# already exported by the shell. Compose reads CONVEYOR_POSTGRES_VOLUME too.
CONVEYOR_DATABASE_URL=postgres://conveyor:conveyor@127.0.0.1:5432/conveyor?sslmode=disable
CONVEYOR_API_TOKEN=replace-with-openssl-rand-hex-32
CONVEYOR_LLM_API_KEY=
# CONVEYOR_LLM_BASE_URL=
CONVEYOR_ADDR=http://127.0.0.1:8080
CONVEYOR_WORKSPACE=demo

# Encrypts per-user GitHub tokens at rest; required before anyone can store
# the token task execution needs. Generate with: openssl rand -base64 32
# CONVEYOR_FORGE_TOKEN_ENCRYPTION_KEY=

# External dashboard URL. Sign-in links and request-origin checks use it;
# set it whenever users reach the server at anything other than localhost.
# CONVEYOR_PUBLIC_URL=

# Keep the default for a new database. Existing installations can set this to
# the name of their current Docker volume before the first Compose start.
CONVEYOR_POSTGRES_VOLUME=conveyor-postgres-data

# Dedicated disposable integration-test Postgres; never point tests at 5432.
CONVEYOR_TEST_POSTGRES_PORT=5433

# Control-plane models
CONVEYOR_CONTROL_PLANE_MODEL=gpt-5.6-luna
CONVEYOR_PLANNING_MODEL=gpt-5.6-luna

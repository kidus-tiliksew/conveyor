{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "playwright.config.ts"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
		"recommended": true,
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
		"recommended": true,
        "noDoubleEquals": "error"
	  },
	  "a11y": {
		"recommended": true
      }
    }
  }
}

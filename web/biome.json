{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "tests/**/*.ts",
      "playwright.config.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "recommended": true,
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "recommended": true,
        "noDoubleEquals": "error"
      },
      "a11y": {
        "recommended": true
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["**/lib/activity"],
                "importNamePattern": "gateBadge",
                "message": "gateBadge is deleted: the gate is the server's next_action (feature-operator-next-action NA-9)."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/activity.ts"],
      "plugins": ["./biome/no-client-gate-derivation.grit"]
    }
  ]
}
